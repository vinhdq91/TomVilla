---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Villa from '../components/home/Villa.astro';
import Stay from '../components/home/Stay.astro';
import Location from '../components/home/Location.astro';
import Faqs from '../components/home/Faqs.astro';

const site = (await getEntry('site', 'site'))!.data;
const home = (await getEntry('home', 'home'))!.data;
const spaces = (await getCollection('spaces')).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <Hero {...home.hero} />
  <Villa content={home.villa} spaces={spaces} />
  <Stay content={home.stay} whatsapp={site.whatsapp} email={site.email} />
  <Location content={home.location} mapQuery={site.mapQuery} />
  <Faqs faqs={home.faqs} />
</Layout>
