---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import Logo from './Logo.astro';

interface Props {
  site: CollectionEntry<'site'>['data'];
}
const { site } = Astro.props;

const contacts = [
  { icon: 'lucide:message-circle', label: 'WhatsApp', value: site.phone, href: `https://wa.me/${site.whatsapp}` },
  { icon: 'lucide:messages-square', label: 'Zalo', value: site.zalo, href: `https://zalo.me/${site.zalo}` },
  { icon: 'lucide:mail', label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { icon: 'lucide:map-pin', label: 'Address', value: site.address, href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}` },
];
---

<footer id="contact" class="bg-forest text-white">
  <div class="section">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Logo class="h-14 w-10 text-white/80" />
        <h2 class="mt-6 text-5xl">{site.name}</h2>
        <p class="mt-2 text-[0.7rem] uppercase tracking-[0.3em] text-white/70">{site.tagline}</p>
        <p class="mt-8 max-w-sm leading-relaxed text-white/80">
          Questions, special requests or just want to say hello? We usually reply within a few hours.
        </p>
      </div>

      <ul class="grid gap-px self-start bg-white/15 sm:grid-cols-2 lg:col-span-7">
        {
          contacts.map((c) => (
            <li class="bg-forest">
              <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="flex h-full gap-4 p-6 transition-colors hover:bg-forest-deep">
                <Icon name={c.icon} class="mt-0.5 size-5 shrink-0 text-white/70" aria-hidden="true" />
                <span>
                  <span class="block text-[0.7rem] uppercase tracking-[0.2em] text-white/60">{c.label}</span>
                  <span class="mt-1 block whitespace-pre-line">{c.value}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15 px-6 py-6 text-xs text-white/60 sm:px-10 lg:px-16">
    © {new Date().getFullYear()} {site.name}, Hoi An, Vietnam
  </div>
</footer>
