---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'home'>['data']['hero'];
const { title, subtitle, text, buttonLabel, image } = Astro.props;
---

<section id="home" class="relative isolate flex min-h-[34rem] items-center overflow-hidden lg:h-[min(88vh,52rem)]">
  <Image
    src={image}
    alt=""
    widths={[640, 960, 1280, 1920, 2400]}
    sizes="(min-width: 1024px) calc(100vw - 7.5rem), 100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-black/55 via-black/25 to-transparent"></div>

  <div class="max-w-2xl px-6 py-24 text-white sm:px-10 lg:px-16">
    <h1 class="text-6xl leading-[0.95] sm:text-7xl lg:text-8xl">{title}</h1>
    <p class="mt-3 font-serif text-3xl sm:text-4xl lg:text-5xl">{subtitle}</p>
    <p class="mt-8 max-w-md text-base leading-relaxed text-white/90 sm:text-lg">{text}</p>
    <a
      href="#stay"
      class="mt-10 inline-block rounded-full bg-white px-7 py-3.5 text-[0.7rem] font-normal uppercase tracking-[0.25em] text-ink transition-colors hover:bg-cream"
    >
      {buttonLabel}
    </a>
  </div>
</section>
