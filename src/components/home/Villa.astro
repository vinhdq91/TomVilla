---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'home'>['data']['villa'];
  spaces: CollectionEntry<'spaces'>[];
}
const { content, spaces } = Astro.props;
---

<section id="villa" class="section">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4 lg:pr-6">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 class="mt-4 text-5xl leading-tight">{content.heading}</h2>
      <p class="mt-6 text-[0.95rem] leading-relaxed text-muted">{content.text}</p>
      <a href="#stay" class="btn-primary mt-8">
        Check Availability <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:col-span-8">
      {
        spaces.map(({ data }) => (
          <article class="group bg-sand">
            <div class="aspect-4/3 overflow-hidden">
              <Image
                src={data.image}
                alt={data.name}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                class="size-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <div class="flex items-start justify-between gap-4 px-5 py-5">
              <div>
                <h3 class="font-serif text-xl">{data.name}</h3>
                <p class="mt-1 text-sm text-muted">{data.summary}</p>
              </div>
              <Icon name="lucide:arrow-right" class="mt-1.5 size-4 shrink-0 text-muted" aria-hidden="true" />
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <ul class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-line pt-12 sm:grid-cols-3 lg:grid-cols-6">
    {
      content.amenities.map((a) => (
        <li class="flex flex-col items-center gap-3 text-center">
          <Icon name={`lucide:${a.icon}`} class="size-6 text-olive" aria-hidden="true" />
          <span class="text-sm">{a.label}</span>
        </li>
      ))
    }
  </ul>
</section>
