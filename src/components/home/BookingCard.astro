---
import { Icon } from 'astro-icon/components';

interface Props {
  villaName: string;
  title: string;
  text: string;
  whatsapp: string;
  email: string;
  maxGuests: number;
}
const { villaName, title, text, whatsapp, maxGuests } = Astro.props;
---

<!-- Sends the dates to /book, which shows availability, the price and the booking form. -->
<div class="mx-auto max-w-md overflow-hidden bg-white shadow-[0_20px_50px_-20px_rgba(0,0,0,0.25)]">
  <div class="bg-forest px-8 py-8 text-center text-white">
    <Icon name="lucide:calendar-days" class="mx-auto size-7 text-white/80" aria-hidden="true" />
    <h3 class="mt-4 font-serif text-3xl">{title}</h3>
    <span class="mx-auto mt-4 block h-px w-10 bg-white/60" aria-hidden="true"></span>
  </div>

  <form id="booking-form" action="/book" method="get" class="space-y-4 px-8 py-8" data-whatsapp={whatsapp} data-villa={villaName}>
    <p class="text-sm leading-relaxed text-muted">{text}</p>

    <div class="grid grid-cols-2 gap-3">
      <label class="block text-xs text-muted">
        Check-in
        <input type="date" name="checkin" class="field mt-1" />
      </label>
      <label class="block text-xs text-muted">
        Check-out
        <input type="date" name="checkout" class="field mt-1" />
      </label>
    </div>
    <label class="block text-xs text-muted">
      Guests
      <select name="guests" class="field mt-1">
        {Array.from({ length: maxGuests }, (_, i) => <option value={i + 1} selected={i === 1}>{i + 1}</option>)}
      </select>
    </label>

    <button type="submit" class="btn-primary w-full justify-between">
      Check availability & price <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
    </button>
    <button type="button" id="booking-whatsapp" class="w-full text-center text-xs text-muted underline underline-offset-4 hover:text-ink">
      or ask us on WhatsApp
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const checkin = form.elements.namedItem('checkin') as HTMLInputElement;
  const checkout = form.elements.namedItem('checkout') as HTMLInputElement;

  // Today's date in the visitor's own time zone, as YYYY-MM-DD.
  const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  checkin.min = today;
  checkout.min = today;
  checkin.addEventListener('change', () => {
    checkout.min = checkin.value || today;
    if (checkout.value && checkout.value <= checkin.value) checkout.value = '';
  });

  // Don't send empty dates to /book.
  form.addEventListener('submit', () => {
    if (!checkin.value) checkin.disabled = true;
    if (!checkout.value) checkout.disabled = true;
    setTimeout(() => (checkin.disabled = checkout.disabled = false));
  });

  const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  document.getElementById('booking-whatsapp')!.addEventListener('click', () => {
    const data = new FormData(form);
    const msg = [
      `Hello ${form.dataset.villa}! I'd like to check availability:`,
      checkin.value ? `Check-in: ${fmt(checkin.value)}` : '',
      checkout.value ? `Check-out: ${fmt(checkout.value)}` : '',
      `Guests: ${data.get('guests')}`,
    ]
      .filter(Boolean)
      .join('\n');
    window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });
</script>
