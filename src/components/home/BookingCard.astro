---
import { Icon } from 'astro-icon/components';

interface Props {
  villaName: string;
  title: string;
  text: string;
  whatsapp: string;
  email: string;
}
const { villaName, title, text, whatsapp, email } = Astro.props;
---

<!--
  v1: sends the guest's dates to WhatsApp (or email) — no server needed.
  v2: this form will post to a booking API backed by Cloudflare D1.
-->
<div class="mx-auto max-w-md overflow-hidden bg-white shadow-[0_20px_50px_-20px_rgba(0,0,0,0.25)]">
  <div class="bg-forest px-8 py-8 text-center text-white">
    <Icon name="lucide:calendar-days" class="mx-auto size-7 text-white/80" aria-hidden="true" />
    <h3 class="mt-4 font-serif text-3xl">{title}</h3>
    <span class="mx-auto mt-4 block h-px w-10 bg-white/60" aria-hidden="true"></span>
  </div>

  <form id="booking-form" class="space-y-4 px-8 py-8" data-whatsapp={whatsapp} data-email={email} data-villa={villaName}>
    <p class="text-sm leading-relaxed text-muted">{text}</p>

    <div class="grid grid-cols-2 gap-3">
      <label class="block text-xs text-muted">
        Check-in
        <input type="date" name="checkin" required class="field mt-1" />
      </label>
      <label class="block text-xs text-muted">
        Check-out
        <input type="date" name="checkout" required class="field mt-1" />
      </label>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <label class="block text-xs text-muted">
        Guests
        <select name="guests" class="field mt-1">
          {Array.from({ length: 10 }, (_, i) => <option value={i + 1} selected={i === 1}>{i + 1}</option>)}
        </select>
      </label>
      <label class="block text-xs text-muted">
        Your name
        <input type="text" name="name" autocomplete="name" class="field mt-1" />
      </label>
    </div>

    <p id="booking-error" class="hidden text-sm text-red-700" role="alert"></p>

    <button type="submit" class="btn-primary w-full justify-between">
      Ask on WhatsApp <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
    </button>
    <button type="button" id="booking-email" class="w-full text-center text-xs text-muted underline underline-offset-4 hover:text-ink">
      or send by email
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const error = document.getElementById('booking-error')!;
  const checkin = form.elements.namedItem('checkin') as HTMLInputElement;
  const checkout = form.elements.namedItem('checkout') as HTMLInputElement;

  // Today's date in the visitor's own time zone, as YYYY-MM-DD.
  const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  checkin.min = today;
  checkout.min = today;
  checkin.addEventListener('change', () => {
    checkout.min = checkin.value || today;
    if (checkout.value && checkout.value <= checkin.value) checkout.value = '';
  });

  const fmt = (d: string) =>
    new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  function buildMessage(): string | null {
    error.classList.add('hidden');
    if (!checkin.value || !checkout.value || checkout.value <= checkin.value) {
      error.textContent = 'Please choose a check-out date after your check-in date.';
      error.classList.remove('hidden');
      return null;
    }
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    return [
      `Hello ${form.dataset.villa}! I'd like to check availability:`,
      `Check-in: ${fmt(checkin.value)}`,
      `Check-out: ${fmt(checkout.value)}`,
      `Guests: ${data.get('guests')}`,
      name ? `Name: ${name}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = buildMessage();
    if (msg) window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });

  document.getElementById('booking-email')!.addEventListener('click', () => {
    const msg = buildMessage();
    if (msg)
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Availability request')}&body=${encodeURIComponent(msg)}`;
  });
</script>
