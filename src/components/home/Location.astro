---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'home'>['data']['location'];
  mapQuery: string;
}
const { content, mapQuery } = Astro.props;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=14&output=embed`;
---

<section id="location" class="section bg-sand/60">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 class="mt-4 text-5xl leading-tight">{content.heading}</h2>
      <p class="mt-6 text-[0.95rem] leading-relaxed text-muted">{content.text}</p>

      <dl class="mt-10 divide-y divide-line border-y border-line">
        {
          content.distances.map((d) => (
            <div class="flex items-baseline justify-between gap-6 py-4">
              <dt class="font-serif text-xl">{d.place}</dt>
              <dd class="text-sm text-muted">{d.time}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="grid gap-6 lg:col-span-7 lg:grid-rows-[auto_1fr]">
      {
        content.image && (
          <Image
            src={content.image}
            alt="Hoi An"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="aspect-16/9 w-full object-cover"
          />
        )
      }
      <iframe
        src={mapSrc}
        title="Map showing the villa's location"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-72 w-full border-0 grayscale-[35%] lg:h-full lg:min-h-64"></iframe>
    </div>
  </div>
</section>
