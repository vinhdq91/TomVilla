{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "tomvilla",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Booking database. Tables are created from the SQL files in ./migrations
	// (`npm run db:migrate:local` on this computer, `npm run deploy` online).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tomvilla",
			"database_id": "9a704778-f5ec-4f63-a0e3-006d3c61e7ab",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
